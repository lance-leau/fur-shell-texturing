#version 450

in vec3 v_normal;
in float v_height;

layout(location = 0) out vec4 output_color;

const vec3 light_dir = normalize(vec3(1.0, 1.5, 0.5));
const vec3 bunny_color = vec3(0.8, 0.6, 0.4);

void main()
{
    float diffuse = max(dot(normalize(v_normal), light_dir), 0.0);
    // the shells get lighter toward the tip
    vec3 color = bunny_color * mix(0.4, 1.0, v_height);
    output_color = vec4(color * (0.3 + 0.7 * diffuse), 1.0);
}
