#version 450

in vec3 v_root;
in vec3 v_skin_normal;
in vec3 v_normal;
in float v_height;

uniform float strand_density;

layout(location = 0) out vec4 output_color;

const vec3 light_dir = normalize(vec3(1.0, 1.5, 0.5));
const float light_power = 1.3;
// the camera looks at the bunny from (1, 1, 1)
const vec3 view_dir = normalize(vec3(1.0, 1.0, 1.0));
const vec3 root_color = vec3(0.45, 0.33, 0.24);
const vec3 tip_color = vec3(0.95, 0.86, 0.72);

// pseudo random number in [0, 1[ for a cell of the grid
float hash(vec3 cell)
{
    return fract(sin(dot(cell, vec3(12.9898, 78.233, 45.164))) * 43758.5453);
}

// 2D coordinates on the skin: the root is projected on the plane (yz, xz or
// xy) that faces the normal the most. The z of the result tells which plane.
// slope: the normal projected on this plane (its length is sin(tilt))
// cos_tilt: cosine of the angle between the normal and the axis of the plane
vec3 skin_coordinates(out vec2 slope, out float cos_tilt)
{
    vec3 n = normalize(v_skin_normal);
    vec3 a = abs(n);
    if (a.x > a.y && a.x > a.z)
    {
        slope = n.yz;
        cos_tilt = a.x;
        return vec3(v_root.yz, 0.0);
    }
    if (a.y > a.z)
    {
        slope = n.xz;
        cos_tilt = a.y;
        return vec3(v_root.xz, 1.0);
    }
    slope = n.xy;
    cos_tilt = a.z;
    return vec3(v_root.xy, 2.0);
}

void main()
{
    // the skin is cut in a 2D grid, each cell holds one strand
    vec2 slope;
    float cos_tilt;
    vec3 coord = skin_coordinates(slope, cos_tilt);
    vec2 p = coord.xy * strand_density;
    // every other row is shifted by half a cell (like bricks), so the
    // strands are not aligned in columns
    p.x += 0.5 * mod(floor(p.y), 2.0);
    vec3 cell = vec3(floor(p), coord.z);

    // position inside the cell, from -0.5 to 0.5
    vec2 local = fract(p) - 0.5;
    // the strand is not exactly at the center of its cell
    vec2 center = (vec2(hash(cell), hash(cell + 7.0)) - 0.5) * 0.2;
    // random length, so the top of the fur is not flat
    float strand_length = mix(0.2, 1.0, hash(cell + 13.0));

    // position along the strand: 0 at the root, 1 at the tip
    float t = v_height / strand_length;
    // each strand leans in its own random direction
    vec2 lean = (vec2(hash(cell + 41.0), hash(cell + 43.0)) - 0.5) * 0.5;
    center += t * lean;
    // the strand stays thick and only gets thin near its tip
    float radius = 0.4 * sqrt(max(1.0 - t, 0.0));

    // where the skin is tilted compared to the plane of the grid, a circle
    // drawn on the plane becomes an ellipse on the skin, stretched by
    // 1 / cos_tilt along the slope. The offset is stretched the same way so
    // the strand is round on the skin. (1 / cos - 1) / sin^2 simplifies to
    // 1 / (cos * (1 + cos)), which never divides by 0.
    vec2 offset = local - center;
    offset += dot(offset, slope) * slope / (cos_tilt * (1.0 + cos_tilt));

    // shell 0 is the skin, it is never cut
    if (v_height > 0.0 && length(offset) > radius)
        discard;

    vec3 n = normalize(v_normal);
    // half lambert: the side away from the light is not black
    float diffuse = dot(n, light_dir) * 0.5 + 0.5;
    diffuse *= diffuse;
    // fake shadow: deep in the fur there is less light
    float occlusion = mix(0.35, 1.0, v_height);
    // each strand has a slightly different color
    float tint = mix(0.8, 1.2, hash(cell + 29.0));
    vec3 color = mix(root_color, tip_color, clamp(t, 0.0, 1.0)) * tint;
    // the tips on the silhouette catch the light
    float rim = pow(1.0 - max(dot(n, view_dir), 0.0), 3.0);

    color = light_power * color * diffuse * occlusion
        + 0.3 * rim * v_height * tip_color;
    output_color = vec4(color, 1.0);
}
