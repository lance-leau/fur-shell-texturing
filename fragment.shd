#version 450

in vec3 v_root;
in vec3 v_skin_normal;
in vec3 v_normal;
in float v_height;

uniform float strand_density;

layout(location = 0) out vec4 output_color;

const vec3 light_dir = normalize(vec3(1.0, 1.5, 0.5));
const float light_power = 1.3;
const vec3 view_dir = normalize(vec3(1.0, 1.0, 1.0));
const vec3 root_color = vec3(0.45, 0.33, 0.24);
const vec3 tip_color = vec3(0.95, 0.86, 0.72);

float hash(vec3 cell)
{
    return fract(sin(dot(cell, vec3(12.9898, 78.233, 45.164))) * 43758.5453);
}

vec3 skin_coordinates(out vec2 slope, out float cos_tilt)
{
    vec3 n = normalize(v_skin_normal);
    vec3 a = abs(n);
    if (a.x > a.y && a.x > a.z)
    {
        slope = n.yz;
        cos_tilt = a.x;
        return vec3(v_root.yz, 0.0);
    }
    if (a.y > a.z)
    {
        slope = n.xz;
        cos_tilt = a.y;
        return vec3(v_root.xz, 1.0);
    }
    slope = n.xy;
    cos_tilt = a.z;
    return vec3(v_root.xy, 2.0);
}

void main()
{
    vec2 slope;
    float cos_tilt;
    vec3 coord = skin_coordinates(slope, cos_tilt);
    vec2 p = coord.xy * strand_density;
    p.x += 0.5 * mod(floor(p.y), 2.0);
    vec3 cell = vec3(floor(p), coord.z);

    vec2 local = fract(p) - 0.5;
    vec2 center = (vec2(hash(cell), hash(cell + 7.0)) - 0.5) * 0.3;
    float strand_length = mix(0.1, 1.0, hash(cell + 13.0));

    float t = v_height / strand_length;
    vec2 lean = (vec2(hash(cell + 41.0), hash(cell + 43.0)) - 0.5) * 0.9;
    center += t * lean;
    float radius = 0.3 * sqrt(max(1.0 - t, 0.0));

    vec2 offset = local - center;
    offset += dot(offset, slope) * slope / (cos_tilt * (1.0 + cos_tilt));

    if (v_height > 0.0 && length(offset) > radius)
        discard;

    vec3 n = normalize(v_normal);
    float diffuse = dot(n, light_dir) * 0.5 + 0.5;
    diffuse *= diffuse;
    float occlusion = mix(0.5, 1.0, v_height);
    float tint = mix(0.7, 1.3, hash(cell + 29.0));
    vec3 color = mix(root_color, tip_color, clamp(t, 0.0, 1.0)) * tint;
    float rim = pow(1.0 - max(dot(n, view_dir), 0.0), 3.0);

    color = light_power * color * diffuse * occlusion
        + 0.15 * rim * v_height * tip_color;
    output_color = vec4(color, 1.0);
}
