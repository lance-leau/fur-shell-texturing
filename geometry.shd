#version 450

layout(triangles) in;
layout(line_strip, max_vertices = 10) out;

in vec3 v_normal[];
out vec3 color;

vec3 light_position = vec3(-10.0, -10.0, -50.0);
vec3 object_color = vec3(1.0, 1.0, 1.0);

mat4 model_view_matrix = mat4(0.57735, -0.33333, 0.57735, 0.00000, 0.00000,
                              0.66667, 0.57735, 0.00000, -0.57735, -0.33333,
                              0.57735, 0.00000, 0.00000, 0.00000, -17, 1.00000);

mat4 projection_matrix = mat4(
    15.00000, 0.00000, 0.00000, 0.00000, 0.00000, 15.00000, 0.00000, 0.00000,
    0.00000, 0.00000, -1.00020, -1.00000, 0.00000, 0.00000, -10.00100, 0.00000);

void main()
{
    vec4 center =
        (gl_in[0].gl_Position + gl_in[1].gl_Position + gl_in[2].gl_Position)
        / 3.0;
    vec3 normal = normalize(v_normal[0] + v_normal[1] + v_normal[2]);

    float c =
        clamp(dot(normalize(center.xyz - light_position), normal), 0.0, 1.0);
    color = object_color * c;

    gl_Position = projection_matrix * model_view_matrix * center;
    EmitVertex();

    gl_Position = projection_matrix * model_view_matrix
        * vec4(center.xyz + normal * 0.1f, 1.0f);
    vec3 fur_color = vec3(0.5f, 0.3f, 0.1f) * c;
    color = fur_color;
    EmitVertex();

    vec3 p = center.xyz + normal * 0.1f;
    vec3 dir = normal;
    for (int i = 0; i < 8; i++)
    {
        dir = normalize(dir - vec3(0.0f, 0.3f, 0.0f));
        p += dir * 0.01f;
        gl_Position = projection_matrix * model_view_matrix * vec4(p, 1.0f);
        color = fur_color;
        EmitVertex();
    }
    EndPrimitive();
}