#version 450

layout(location = 0) in vec3 position;
layout(location = 1) in vec3 normalSmooth;

struct Strand
{
    vec4 tip;
    vec4 previous;
};

layout(std430, binding = 2) readonly buffer strands_buffer
{
    Strand strands[];
};

uniform mat4 model_matrix;
uniform int shell_count;
uniform float fur_length;

out vec3 v_root;
out vec3 v_skin_normal;
out vec3 v_normal;
out float v_height;
out vec3 v_world;
out vec4 v_tip;

mat4 view_matrix = mat4(0.57735, -0.33333, 0.57735, 0.00000, 0.00000, 0.66667,
                        0.57735, 0.00000, -0.57735, -0.33333, 0.57735, 0.00000,
                        0.00000, 0.00000, -17, 1.00000);

mat4 projection_matrix = mat4(
    24.00000, 0.00000, 0.00000, 0.00000, 0.00000, 24.00000, 0.00000, 0.00000,
    0.00000, 0.00000, -1.00020, -1.00000, 0.00000, 0.00000, -10.00100, 0.00000);

void main()
{
    float h = float(gl_InstanceID) / float(max(shell_count - 1, 1));

    vec3 root = (model_matrix * vec4(position, 1.0)).xyz;
    vec3 normal = normalize(mat3(model_matrix) * normalSmooth);
    vec3 middle = root + normal * fur_length * 0.5;
    vec3 tip = strands[gl_VertexID].tip.xyz;
    vec3 p = (1.0 - h) * (1.0 - h) * root + 2.0 * h * (1.0 - h) * middle
        + h * h * tip;

    mat4 view_projection = projection_matrix * view_matrix;
    gl_Position = view_projection * vec4(p, 1.0);

    v_root = position;
    v_skin_normal = normalSmooth;
    v_normal = normal;
    v_height = h;

    v_world = root;
    v_tip = view_projection * vec4(tip, 1.0);
}
