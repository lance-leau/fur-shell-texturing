#version 450

// one invocation per vertex of the mesh: it moves the tip of the strand that
// grows on this vertex, by one time step
layout(local_size_x = 64) in;

// the VBOs of the mesh, read as arrays of floats (x, y, z, x, y, z, ...)
layout(std430, binding = 0) readonly buffer positions_buffer
{
    float positions[];
};

layout(std430, binding = 1) readonly buffer normals_buffer
{
    float normals[];
};

// the tip of each strand now and one step before, in world space (w unused)
struct Strand
{
    vec4 tip;
    vec4 previous;
};

layout(std430, binding = 2) buffer strands_buffer
{
    Strand strands[];
};

uniform uint vertex_count;
uniform mat4 model_matrix;
uniform float fur_length;
uniform float dt; // time step, always the same
uniform float stiffness; // strength of the spring that keeps the strand up
uniform float damping; // part of the speed kept from one step to the next
uniform float time; // seconds of simulation, moves the wind gusts
uniform float wind_strength; // 0 when the wind is off

const vec3 gravity = vec3(0.0, -9.81, 0.0);
// the wind blows toward the right of the screen (camera right direction)
const vec3 wind_direction = normalize(vec3(1.0, 0.0, -1.0));
const float wind_speed = 1.5; // how fast the gusts travel, units per second
const float gust_size = 0.3; // size of a gust, in world units

// pseudo random number in [0, 1[ for a point of the integer grid
float hash(vec3 p)
{
    return fract(sin(dot(p, vec3(12.9898, 78.233, 45.164))) * 43758.5453);
}

// smooth noise in [0, 1]: a random value on each corner of a grid, blended
// between the corners (value noise, a simpler cousin of Perlin noise)
float noise(vec3 p)
{
    vec3 i = floor(p);
    vec3 f = fract(p);
    // smooth blend, so the grid cannot be seen
    f = f * f * (3.0 - 2.0 * f);
    float x00 = mix(hash(i), hash(i + vec3(1, 0, 0)), f.x);
    float x10 = mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x);
    float x01 = mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x);
    float x11 = mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x);
    return mix(mix(x00, x10, f.y), mix(x01, x11, f.y), f.z);
}

// the noise pattern is carried by the wind: strong and calm zones (gusts)
// travel across the fur. Squared, so the calm zones are really calm
vec3 wind(vec3 p)
{
    float gust = noise((p - wind_direction * wind_speed * time) / gust_size);
    return wind_direction * wind_strength * gust * gust;
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    // the last group of 64 goes past the end of the mesh
    if (i >= vertex_count)
        return;

    vec3 position =
        vec3(positions[3 * i], positions[3 * i + 1], positions[3 * i + 2]);
    vec3 normal = vec3(normals[3 * i], normals[3 * i + 1], normals[3 * i + 2]);

    // the root follows the model. At rest, the strand goes straight out of
    // the skin
    vec3 root = (model_matrix * vec4(position, 1.0)).xyz;
    vec3 n = normalize(mat3(model_matrix) * normal);
    vec3 rest = root + n * fur_length;

    vec3 tip = strands[i].tip.xyz;
    vec3 previous = strands[i].previous.xyz;

    // forces: a spring pulls the tip back to its rest position, the gravity
    // pulls it down, the wind pushes it
    vec3 acceleration = stiffness * (rest - tip) + gravity + wind(tip);

    // Verlet integration: the speed is (tip - previous) / dt, so the tip keeps
    // going the way it was going (inertia), a bit slower each step (damping)
    vec3 next = tip + (tip - previous) * damping + acceleration * dt * dt;

    // the tip does not go under the skin
    float height = dot(next - root, n);
    if (height < 0.0)
        next -= height * n;
    // the strand keeps its length
    next = root + normalize(next - root) * fur_length;

    strands[i].previous = vec4(tip, 0.0);
    strands[i].tip = vec4(next, 0.0);
}
