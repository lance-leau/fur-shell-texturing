#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer positions_buffer
{
    float positions[];
};

layout(std430, binding = 1) readonly buffer normals_buffer
{
    float normals[];
};

struct Strand
{
    vec4 tip;
    vec4 previous;
};

layout(std430, binding = 2) buffer strands_buffer
{
    Strand strands[];
};

uniform uint vertex_count;
uniform mat4 model_matrix;
uniform float fur_length;
uniform float dt;
uniform float stifness;
uniform float damping;
uniform float time;
uniform float windStrength;

const vec3 gravity = vec3(0.0, -9.81, 0.0);
const vec3 wind_direction = normalize(vec3(1.0, 0.0, -1.0));
const float wind_speed = 1.5;
const float gust_size = 0.3;

float hash(vec3 p)
{
    // https://godotshaders.com/shader/a-magical-anomaly/
    return fract(sin(dot(p, vec3(12.9898, 78.233, 45.164))) * 43758.5453);
}

// create 3D noise for the wind
float noise(vec3 p)
{
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float x00 = mix(hash(i), hash(i + vec3(1, 0, 0)), f.x);
    float x10 = mix(hash(i + vec3(0, 1, 0)), hash(i + vec3(1, 1, 0)), f.x);
    float x01 = mix(hash(i + vec3(0, 0, 1)), hash(i + vec3(1, 0, 1)), f.x);
    float x11 = mix(hash(i + vec3(0, 1, 1)), hash(i + vec3(1, 1, 1)), f.x);
    return mix(mix(x00, x10, f.y), mix(x01, x11, f.y), f.z);
}

vec3 wind(vec3 p)
{
    float gust = noise((p - wind_direction * wind_speed * time) / gust_size);
    return wind_direction * windStrength * gust * gust;
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= vertex_count)
        return;

    vec3 position =
        vec3(positions[3 * i], positions[3 * i + 1], positions[3 * i + 2]);
    vec3 normal = vec3(normals[3 * i], normals[3 * i + 1], normals[3 * i + 2]);

    vec3 root = (model_matrix * vec4(position, 1.0)).xyz;
    vec3 n = normalize(mat3(model_matrix) * normal);
    vec3 rest = root + n * fur_length;

    vec3 tip = strands[i].tip.xyz;
    vec3 previous = strands[i].previous.xyz;

    vec3 acceleration = stifness * (rest - tip) + gravity + wind(tip);

    vec3 next = tip + (tip - previous) * damping + acceleration * dt * dt;

    float height = dot(next - root, n);
    if (height < 0.0)
        next -= height * n;
    next = root + normalize(next - root) * fur_length;

    // fill in the SSBO
    strands[i].previous = vec4(tip, 0.0);
    strands[i].tip = vec4(next, 0.0);
}
